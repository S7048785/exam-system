export com.yyjy.exam.entity.exam.entity.ExamRecords
    -> package com.yyjy.exam.entity.exam.dto

ExamStartView {
    id
    paper {
        id
    }
    userId
    studentName
    score
    startTime
    status
    windowSwitches
}

ExamTakingView {
    id
    userId
    studentName
    startTime
    status
    windowSwitches
    paper {
        id
        name
        description
        published
        totalScore
        questionCount
        examSettings {
            duration
        }
        paperQuestions as questions {
            flat(question) {
                id
                title
                type
                difficulty
                score
                questionChoices as choices {
                    content
                    sort
                }
            }
        }
    }
}

ExamRecordDetail {
    id
    userId
    studentName
    score
    startTime
    endTime
    status
    windowSwitches
    answerRecords {
        id
        examRecordId
        questionId
        userAnswer
        score
        correct
        aiCorrection
    }
    paper {
        id
        name
        description
        published
        totalScore
        questionCount
        examSettings {
            duration
        }
        paperQuestions as questions {
            flat(question) {
                id
                title
                type
                difficulty
                score
                questionChoices as choices {
                    content
                    correct
                    sort
                }
                flat(questionAnswers) {
                    answer
                }
            }
        }
    }
}

