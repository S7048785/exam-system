export com.yyjy.exam.entity.question.entity.Questions
    -> package com.yyjy.exam.entity.question.dto

QuestionsPageView {
    id
    title
    type
    categoryId
    difficulty
    score
    analysis
    questionChoices as choices  {
        id
        questionId
        content
        correct
        sort
    }
    questionAnswers as answers  {
        id
        questionId
        answer
    }
    createTime
    updateTime
}

input QuestionSaveInput {
    title
    type
    categoryId
    difficulty
    score
    analysis
    questionChoices? as choices  {
        content
        correct
        sort
    }
    questionAnswers as answers  {
        answer
    }
}

QuestionImportView {
    title
    type
    categoryId
    difficulty
    score
    analysis
    questionChoices? as choices  {
        content
        correct
        sort
    }
    flat(questionAnswers) {
        answer
    }
}

input QuestionImportInput {
    title
    type
    categoryId
    difficulty
    score
    analysis
    questionChoices? as choices  {
        content
        correct
        sort
    }
    flat(questionAnswers) {
        answer
    }
}
