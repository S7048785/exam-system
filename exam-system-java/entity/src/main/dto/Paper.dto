export com.yyjy.exam.entity.paper.entity.Paper
    -> package com.yyjy.exam.entity.paper.dto

import com.yyjy.exam.common.constant.MessageConstant
import jakarta.validation.constraints.Min
import jakarta.validation.constraints.NotNull

PaperDetail {
    id
    name
    description
    categoryId
    published
    participateMode
    maxAttempts
    totalScore
    questionCount
    duration
    start
    end
    paperQuestions as questions {
        flat(question) {
            id
            title
            type
            questionChoices as choices {
                content
                correct
            }
            flat(questionAnswers) {
                answer
            }
        }
        score
    }
    createTime
}

specification PaperListQuery {
    published
    ongoing: Boolean?
    page: Int?
    size: Int?
}

input PaperSaveInput {
    name
    description
    duration
    categoryId
    start
    end
    participateMode
    @Min(value = 1, message = MessageConstant.PAPER_MAX_ATTEMPTS_INVALID)
    maxAttempts
}