export com.yyjy.exam.entity.paper.entity.Paper
    -> package com.yyjy.exam.entity.paper.dto

PaperDetail {
    id
    name
    description
    categoryId
    published
    participateMode
    maxAttempts
    totalScore
    questionCount
    duration
    start
    end
    paperQuestions as questions {
        flat(question) {
            id
            title
            type
            questionChoices as choices {
                content
                correct
            }
            flat(questionAnswers) {
                answer
            }
        }
        score
    }
    createTime
}

specification PaperListQuery {
    published
    ongoing: Boolean?
    page: Int?
    size: Int?
}

input PaperSaveInput {
    name
    description
    duration
    categoryId
    start
    end
    // 可选：不传则用默认值（LOGIN_REQUIRED / 1），这样前端不传也不会破坏建卷流程
    participateMode?
    maxAttempts?
}