export com.yyjy.exam.entity.paper.entity.Paper
    -> package com.yyjy.exam.entity.paper.dto

import com.yyjy.exam.entity.constant.ValidationMessage
import jakarta.validation.constraints.Min

PaperDetail {
    id
    name
    description
    categoryId
    published
    participateMode
    totalScore
    questionCount
    examSettings {
        duration
        start
        end
        passingScore
        @Min(value = 1, message = ValidationMessage.PAPER_MAX_ATTEMPTS_INVALID)
        maxAttempts
        requireAllAnswered
        hideQuestionScore
        showRankAfterSubmit
        showAnswerAfterSubmit
        minAnswerMinutes
        shuffleQuestions
        shuffleChoices
    }
    paperQuestions as questions {
        flat(question) {
            id
            title
            type
            questionChoices as choices {
                content
                correct
            }
            flat(questionAnswers) {
                answer
            }
        }
        score
    }
    createTime
}

input PaperSaveInput {
    id
    name
    description
    categoryId
    participateMode
}
