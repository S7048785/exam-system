export com.yyjy.exam.entity.paper.entity.Paper
    -> package com.yyjy.exam.entity.paper.dto

import com.yyjy.exam.common.constant.MessageConstant
import jakarta.validation.constraints.Min
import jakarta.validation.constraints.NotNull

PaperDetail {
    id
    name
    description
    categoryId
    published
    participateMode
    maxAttempts
    totalScore
    questionCount
    duration
    start
    end
    paperQuestions as questions {
        flat(question) {
            id
            title
            type
            questionChoices as choices {
                content
                correct
            }
            flat(questionAnswers) {
                answer
            }
        }
        score
    }
    createTime
}

specification PaperListQuery {
    published
    ongoing: Boolean?
    page: Int?
    size: Int?
}

input PaperSaveInput {
    name
    description
    duration
    categoryId
    start
    end
    // 参与方式：只允许 ParticipateMode 的固定取值（ANONYMOUS / LOGIN_REQUIRED）
    // 非法字符串在反序列化阶段就被拒（422）；数字序号（0/1）由
    // spring.jackson.deserialization.fail-on-numbers-for-enums=true 一并关掉
    @NotNull(message = MessageConstant.PAPER_PARTICIPATE_MODE_REQUIRED)
    participateMode
    @Min(value = 1, message = MessageConstant.PAPER_MAX_ATTEMPTS_INVALID)
    maxAttempts
}